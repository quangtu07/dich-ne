<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- F1/F2 gọi Gemini qua HTTPS; quyền lúc cài, không xin runtime (spec §6). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- F2 (P3): bong bóng nổi trên app khác + foreground service giữ bong bóng. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- F2/F3 (P4): chụp màn hình bằng MediaProjection (1 consent/phiên). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- F12: banner cập nhật side-load — cần quyền mở trình cài APK (không dùng cho Play). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- F10: API 30+ cần khai báo để thấy service TTS hệ thống (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".BubbleDictApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BubbleDict">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BubbleDict">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- F1 (BE-11): nhận text bôi đen từ app khác qua ACTION_PROCESS_TEXT, cửa sổ translucent.
             label lấy từ string action_translate để menu chọn hiện "Dịch" (AC1). -->
        <activity
            android:name=".ui.result.ResultActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/action_translate"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.BubbleDict.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Màn dev để render ResultSheet với dữ liệu mẫu (không xuất ra ngoài app). -->
        <activity
            android:name=".ui.result.ResultPreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDict" />

        <!-- Màn dev seed lịch sử + render HistoryScreen cho QA chụp ảnh. -->
        <activity
            android:name=".ui.history.HistoryDevActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDict" />

        <!-- Màn dev seed từ vựng + render VocabScreen cho QA chụp ảnh. -->
        <activity
            android:name=".ui.vocab.VocabDevActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDict" />

        <!-- Màn dev render Settings cho QA chụp ảnh. -->
        <activity
            android:name=".ui.settings.SettingsDevActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDict" />

        <!-- F2 (BE-13): foreground service giữ bong bóng nổi trên app khác. -->
        <service
            android:name=".platform.BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="bubble_overlay_dictionary" />
        </service>

        <!-- F3 (BE-14): foreground service giữ MediaProjection + VirtualDisplay cả phiên. -->
        <service
            android:name=".platform.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- F2/F3: màn chọn vùng OCR (translucent, khung BE dựng, FE nâng UI). -->
        <activity
            android:name=".ui.region.RegionSelectActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.BubbleDict.Translucent" />

        <!-- F12: chia sẻ file APK tải về cho trình cài (Android 8+ bắt buộc content:// URI). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Màn dev kiểm tra TTS voice en-US/en-GB trên máy đang chạy. -->
        <activity
            android:name=".ui.debug.TtsProbeActivity"
            android:exported="false"
            android:theme="@style/Theme.BubbleDict" />
    </application>

</manifest>