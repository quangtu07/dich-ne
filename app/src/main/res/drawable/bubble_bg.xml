<?xml version="1.0" encoding="utf-8"?>
<!-- Designer bubble-region.md §2.1 v2: nền gradient ĐẬM #4A5FA5 -> #7C5AC8 + inner ring 1dp trắng 35%.
     Đảo từ bản sáng vì chữ "A" trắng trên nền sáng chỉ tương phản ~1.2:1 (gần như vô hình).
     Dùng làm background cho view bong bóng 56dp trong BubbleService. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#4A5FA5"
                android:endColor="#7C5AC8"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
