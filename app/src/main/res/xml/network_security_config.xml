<!--
  1.0.6: siết cleartext — mọi kết nối ra ngoài bắt buộc HTTPS.
  Trước đây có domain-config cho host LAN/Tailscale/10.0.2.2 để test update qua HTTP nội bộ;
  từ khi manifest update nằm trên GitHub raw (https) không còn host nào cần cleartext.
  Ai muốn test update qua HTTP nội bộ thì dùng bản debug (thêm file res/xml riêng) — bản phát
  không mở lại danh sách host này nữa.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>